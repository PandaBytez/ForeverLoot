package-as: ForeverLoot

manual-changelog:
 filename: CHANGELOG.md
 markup-type: markdown

enable-nolib-creation: no

# Ignore takes place before folder's moving takes place
ignore:
 - babelfish.lua
 - cf_translations.sh
 - ForeverLoot/Images/PSD
 - ForeverLoot/Addons/tmpl.lua
 - ForeverLoot_DungeonsAndRaids/droprate_override.lua
 - README.md

move-folders:
 ForeverLoot/ForeverLoot: ForeverLoot
 ForeverLoot/ForeverLoot_Crafting: ForeverLoot_Crafting
 ForeverLoot/ForeverLoot_DungeonsAndRaids: ForeverLoot_DungeonsAndRaids
 ForeverLoot/ForeverLoot_PvP: ForeverLoot_PvP
 ForeverLoot/ForeverLoot_Collections: ForeverLoot_Collections
 ForeverLoot/ForeverLoot_Factions: ForeverLoot_Factions
 ForeverLoot/ForeverLoot_Options: ForeverLoot_Options
 ForeverLoot/ForeverLoot_Data: ForeverLoot_Data